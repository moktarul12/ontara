# Copy to .env — use at least one LLM provider:

# OpenAI (paid after free trial credits)
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini — free tier at https://aistudio.google.com/apikey (recommended free option)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash
